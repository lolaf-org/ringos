<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.lolaf.ringos</groupId>
        <artifactId>ringos-unsafe-operations-impl-25</artifactId>
        <version>0.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>ringos-unsafe-operations-impl-25-provider</artifactId>

    <name>Ringos Unsafe Operations (JDK 25+ Provider)</name>

    <properties>
        <!-- Two levels down, so the licence the parent copies into the jar is two levels up. -->
        <license.source.dir>${project.basedir}/../..</license.source.dir>
        <maven.compiler.release>11</maven.compiler.release>
        <automatic.module.name>org.lolaf.ringos.unsafe.j25.provider</automatic.module.name>
    </properties>

    <description>
        Always-loadable SPI provider (compiled to the parent's Java 11 bytecode default) that selects the
        Java 25 UnsafeOperations implementation. This is the artifact to depend on for Java 25+ support; it
        pulls the implementation in transitively at runtime.
    </description>

    <!-- Inherits the parent's Java 11 compiler release so this provider loads on any supported JDK. -->

    <dependencies>
        <dependency>
            <groupId>org.lolaf.ringos</groupId>
            <artifactId>ringos-unsafe-operations-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
            Runtime-only: the provider names the implementation by string and loads it reflectively, so it must
            not link it at compile time. The runtime dependency makes the (Java 25 bytecode) implementation
            available on the classpath, to be loaded only on a Java 25+ runtime.
        -->
        <dependency>
            <groupId>org.lolaf.ringos</groupId>
            <artifactId>ringos-unsafe-operations-impl-25-impl</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>
</project>
