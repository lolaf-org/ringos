<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.lolaf.ringos</groupId>
        <artifactId>ringos-parent</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>ringos-lib-impl-unsafe</artifactId>

    <name>Ringos Ring Buffer Implementation (Unsafe, JDK 12+)</name>

    <description>
        RingBuffer implementation built on jdk.internal.misc.Unsafe, selected on JDK 12 and later
        when java.base/jdk.internal.misc is opened to it. Depend on ringos-lib-impl-all rather than on this
        directly.
    </description>

    <properties>
        <automatic.module.name>org.lolaf.ringos.rb.unsafe</automatic.module.name>
        <!-- No Lombok in this module: javadoc reads src/main/java directly. -->
        <delombok.skip>true</delombok.skip>
        <javadoc.delomboked.sources>${project.basedir}/src/main/java</javadoc.delomboked.sources>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.lolaf.ringos</groupId>
            <artifactId>ringos-lib-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lolaf.ringos</groupId>
            <artifactId>ringos-unsafe-operations-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.lolaf.ringos</groupId>
            <artifactId>ringos-unsafe-operations-impl-all</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.lolaf.ringos</groupId>
            <artifactId>ringos-lib-impl-testkit</artifactId>
            <version>${project.version}</version>
            <classifier>tests</classifier>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <!-- needed to have access to jdk.internal.misc.Unsafe class -->
                        <arg>--add-exports</arg>
                        <arg>java.base/jdk.internal.misc=ALL-UNNAMED</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <!-- javadoc has to resolve the same JDK internals the compiler is given above. -->
                    <additionalOptions>
                        <additionalOption>--add-exports java.base/jdk.internal.misc=ALL-UNNAMED</additionalOption>
                    </additionalOptions>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>