<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.lolaf.ringos</groupId>
        <artifactId>ringos-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>ringos-lib-api</artifactId>

    <name>Ringos Ring Buffer API</name>
    <description>
        The RingBuffer API and the idling strategies it waits on: RingBufferFactory, the four access
        types, IdleStrategy, FastThreadLocal, and the skeleton the implementations extend. Compile against this
        and add ringos-lib-impl-all at runtime, which supplies an implementation for the JDK in use.
    </description>

    <properties>
        <automatic.module.name>org.lolaf.ringos</automatic.module.name>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lolaf.ringos</groupId>
            <artifactId>ringos-unsafe-operations-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lolaf.ringos</groupId>
            <artifactId>ringos-clib</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <!-- needed to have access Contended class -->
                        <arg>--add-exports</arg>
                        <arg>java.base/jdk.internal.vm.annotation=ALL-UNNAMED</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <!-- javadoc has to resolve the same JDK internals the compiler is given above. -->
                    <additionalOptions>
                        <additionalOption>--add-exports java.base/jdk.internal.vm.annotation=ALL-UNNAMED</additionalOption>
                    </additionalOptions>
                </configuration>
            </plugin>
        </plugins>

    </build>
</project>